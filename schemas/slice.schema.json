{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iiot-prd/schemas/slice.schema.json",
  "title": "切片计划",
  "description": "用户故事级交付单元。卡点 B 的确认对象；单片有硬上限，超限必须再拆。",
  "type": "object",
  "required": ["planVersion", "product", "slices"],
  "properties": {
    "planVersion": { "type": "string", "enum": ["1.0"] },
    "product": { "type": "string" },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "actor", "goal", "pages", "capabilities", "requirements", "nodesBudget", "acceptance", "dependsOn"],
        "properties": {
          "id": { "type": "string", "pattern": "^s-[0-9]{2,}$" },
          "title": { "type": "string", "minLength": 4 },
          "actor": { "type": "string", "description": "一个角色" },
          "goal": { "type": "string", "description": "一个目标，能独立验收" },
          "targets": { "type": "array", "items": { "type": "string", "enum": ["pc", "pda"] } },
          "pages": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string" } },
          "capabilities": { "type": "array", "maxItems": 6, "items": { "type": "string" } },
          "requirements": { "type": "array", "maxItems": 12, "items": { "type": "string" } },
          "nodesBudget": { "type": "integer", "maximum": 80, "minimum": 1 },
          "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["planned", "building", "done"] }
        }
      }
    }
  }
}
