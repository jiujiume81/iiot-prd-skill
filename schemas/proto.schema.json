{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iiot-prd/schemas/proto.schema.json",
  "title": "IIOT-PRD 单一真源数据契约",
  "description": "工业互联网需求分析与高保真原型的唯一真源。容器渲染、PRD 导出、标注迭代、切片合并全部基于本结构。schemaVersion 变更即为 breaking。",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta",
    "modules",
    "pages",
    "capabilities",
    "stateMachines",
    "dataModel",
    "requirements",
    "components",
    "annotations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "stateMachines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateMachine"
      }
    },
    "dataModel": {
      "$ref": "#/$defs/dataModel"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/componentDef"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openQuestion"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "guards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guard"
      }
    },
    "fieldCatalog": {
      "type": "array",
      "description": "业务字段主档：一条 = 一个业务字段，跨页唯一。渲染位通过 field 引用它；位置信息不写在这里，写在组件 props 上",
      "items": {
        "$ref": "#/$defs/fieldCatalogItem"
      }
    },
    "dataSources": {
      "type": "array",
      "description": "全局取数口。字段的 source.ds 只能引用这里声明的 id；页级取数链路表由渲染位反推，不手写",
      "items": {
        "$ref": "#/$defs/dataSource"
      }
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^s-[0-9]{2,}$"
      }
    },
    "actors": {
      "type": "array",
      "description": "角色表：capabilities[].actor 与 contract.actor 只能引用这里的 id",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "exists"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^u-[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "description": "中文岗位名，UI 与 PRD 都用它，不显示 id"
          },
          "dept": {
            "type": "string"
          },
          "exists": {
            "type": "boolean",
            "description": "是否真实存在；false 表示由他人兼任，相关审批必须可关闭"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{1,4}-[A-Za-z0-9_-]+$"
    },
    "meta": {
      "type": "object",
      "required": [
        "product",
        "version",
        "domain",
        "targets",
        "designWidth"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 2
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "domain": {
          "type": "string",
          "enum": [
            "qms",
            "lims",
            "mes",
            "wms",
            "eam",
            "spc",
            "ems",
            "generic"
          ],
          "description": "工业互联网业务域，决定领域词表与状态模板的加载"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "pc",
              "pda"
            ]
          },
          "description": "本产品覆盖的端。双端共享 capabilities / stateMachines / requirements"
        },
        "designWidth": {
          "type": "object",
          "required": [
            "pc"
          ],
          "properties": {
            "pc": {
              "type": "integer",
              "minimum": 1280
            },
            "pda": {
              "type": "integer",
              "minimum": 320
            }
          },
          "description": "画布设计宽＝布局宽，缩放只作用于呈现层，不改变布局宽"
        },
        "baseResolution": {
          "type": "string",
          "default": "1920x1080"
        },
        "currentPageId": {
          "type": "string"
        },
        "skin": {
          "type": "string",
          "enum": [
            "industrial-dark-sider",
            "antd-light",
            "pda-field"
          ],
          "description": "皮肤名，取容器自带皮肤之一"
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "设计令牌覆盖，键名对应 catalog.tokens"
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "code",
        "name",
        "order",
        "pages"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "description": "工业域惯用缩写，如 IQC / OQC / SPC"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "description": "业务归口部门"
        },
        "icon": {
          "type": "string"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "pageGroups": {
          "type": "array",
          "description": "页面目录的分组树。不填则按 parentId 归并；都没有就按页面用途（列表/详情/表单）自动分组。",
          "items": {
            "$ref": "#/$defs/pageGroup"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "moduleId",
        "target",
        "route",
        "title",
        "layout",
        "states",
        "componentTree",
        "interactions",
        "prd"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pg-[A-Za-z0-9_-]+$"
        },
        "moduleId": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "enum": [
            "pc",
            "pda"
          ]
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "description": "多级页面用 parentId 表达层级，不靠命名约定"
        },
        "layout": {
          "type": "string",
          "enum": [
            "list",
            "form",
            "detail",
            "dashboard",
            "wizard",
            "pda-list",
            "pda-step",
            "pda-scan"
          ]
        },
        "entity": {
          "type": "string",
          "description": "主体实体，驱动「单据状态」切换与命令可用性"
        },
        "listRole": {
          "type": "string",
          "enum": [
            "primary",
            "filter"
          ],
          "description": "列表页的角色。primary=主列表（这张单据的唯一入口，整条生命周期都在它的工具栏/行内走完）；filter=主列表的过滤视图（同一张表换筛选，比如「我的待办」）。同一 entity + 同一 target 下有 ≥2 个 list 页时必填，且 primary 恰好一个。故意不设默认值：没写就必须报错，靠「谁按钮多谁是主」推断一定会把执行页认成主列表"
        },
        "subtitle": {
          "type": "string"
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "states": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/pageState"
          }
        },
        "notApplicableStates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "componentTree": {
          "$ref": "#/$defs/componentNode"
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interaction"
          }
        },
        "prd": {
          "$ref": "#/$defs/prd"
        },
        "pda": {
          "$ref": "#/$defs/pdaPolicy"
        }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "task",
        "actor",
        "owns",
        "doneWhen"
      ],
      "properties": {
        "task": {
          "type": "string",
          "description": "谁在什么场景下要完成什么，页面切分的唯一依据"
        },
        "actor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "本页负责发起的命令；一条命令只能有一个主页面 owns"
        },
        "doneWhen": {
          "type": "string"
        },
        "entryFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "submitBoundary": {
          "type": "string"
        }
      }
    },
    "pageState": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s-[A-Za-z0-9_-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "default",
            "loading",
            "empty",
            "zero-result",
            "error",
            "readonly"
          ]
        },
        "desc": {
          "type": "string"
        },
        "vars": {
          "type": "object",
          "description": "该态下的变量默认值，保证页面可独立渲染"
        }
      }
    },
    "componentNode": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^n-[A-Za-z0-9_-]+$"
        },
        "type": {
          "type": "string",
          "description": "必须命中 catalog.json 的 types 白名单"
        },
        "props": {
          "type": "object"
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentNode"
          }
        },
        "visibleWhen": {
          "type": "string",
          "description": "显示条件，引用页面变量或单据状态"
        }
      }
    },
    "interaction": {
      "type": "object",
      "required": [
        "id",
        "on",
        "do"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ix-[A-Za-z0-9_-]+$"
        },
        "on": {
          "type": "string",
          "description": "事件源：节点 id，支持 __row_* / __act_* 通配"
        },
        "do": {
          "type": "string",
          "enum": [
            "navigate",
            "setState",
            "openDrawer",
            "openModal",
            "submit",
            "reset",
            "toast",
            "screenshot"
          ]
        },
        "target": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "effect": {
          "type": "string"
        }
      }
    },
    "prd": {
      "type": "object",
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/prdSection"
          }
        }
      }
    },
    "prdSection": {
      "type": "object",
      "required": [
        "type",
        "heading"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "goal",
            "interaction",
            "availability",
            "rule",
            "state",
            "acceptance",
            "data",
            "api",
            "note"
          ]
        },
        "heading": {
          "type": "string",
          "minLength": 2
        },
        "body": {
          "type": "string",
          "description": "markdown；type=flow 时由 nodes/edges 渲染 SVG"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flowNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flowEdge"
          }
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "flowNode": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "start",
            "end",
            "task",
            "decision",
            "warn",
            "system"
          ]
        },
        "sub": {
          "type": "string",
          "description": "真实路由或真实节点 id，便于对照"
        }
      }
    },
    "flowEdge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "判定节点的每条出边必须有 label"
        }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "name",
        "actor",
        "entity",
        "from",
        "policy",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cap-[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "actor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "entity": {
          "type": "string"
        },
        "from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "允许的前置状态；空表示无状态约束"
        },
        "guard": {
          "type": "string",
          "description": "前置校验，引用 guards[].id 或自然语言条件"
        },
        "policy": {
          "type": "string",
          "enum": [
            "hidden",
            "disabled",
            "reject"
          ]
        },
        "reason": {
          "type": "string",
          "description": "不可用时对用户说什么：当前状态 + 允许状态"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "description": "成功后单据状态"
        },
        "stage": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "submit",
            "verify",
            null
          ]
        },
        "sameActorOk": {
          "type": "boolean"
        },
        "target": {
          "type": "string",
          "description": "targets 子集，缺省继承页面"
        },
        "ui": {
          "$ref": "#/$defs/capUi",
          "description": "这条命令怎么被执行：入口在哪、打开什么承载、要填哪些字段。缺省等于把推进动作留给页面自由发挥，必然堆进详情页"
        },
        "placement": {
          "type": "string",
          "enum": [
            "toolbar",
            "row",
            "form"
          ],
          "description": "命令落在哪：toolbar=列表工具栏（先选中行）、row=行内操作列、form=表单内提交。ui.kind 是 dialog/drawer 时必填；placement=toolbar 且 to 非空时必须给 from，否则按钮永远亮、能重复提交。别用 inline 表示位置——那是 ui.kind 的取值。没有按钮的动作不是命令，是状态机的系统迁移：写 stateMachines[].transitions[].system=true + trigger=system-*，不要造一条没有入口的 capability"
        }
      }
    },
    "capUi": {
      "type": "object",
      "required": [
        "kind",
        "entry"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "inline",
            "dialog",
            "drawer",
            "page"
          ],
          "description": "承载形式：inline=页面内直接完成（查询/导出）；dialog=少量字段弹框；drawer=中等字段侧滑抽屉；page=多区块独立页面"
        },
        "entry": {
          "type": "string",
          "description": "入口节点 id，必须存在于 owns 这条命令的页面组件树内（工具栏按钮或行内操作列）"
        },
        "pageId": {
          "type": "string",
          "description": "kind=page 时承载页面的 id"
        },
        "title": {
          "type": "string",
          "description": "弹层或承载页标题，用业务语言，不用命令名"
        },
        "width": {
          "type": "number",
          "description": "dialog 480~720，drawer 480~640"
        },
        "submitLabel": {
          "type": "string",
          "description": "提交按钮文案，写动作结果（如「提交排查结论」），不写「确定」"
        },
        "successText": {
          "type": "string",
          "description": "提交成功后的反馈文案，必须带出新的单据状态"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formField"
          },
          "description": "需要录入的字段。为空说明这个动作只做确认，弹层里只有一句提示"
        }
      }
    },
    "formField": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "textarea",
            "number",
            "date",
            "select",
            "user",
            "radio",
            "upload",
            "readonly"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "select/radio 的候选值"
        },
        "placeholder": {
          "type": "string"
        },
        "hint": {
          "type": "string",
          "description": "字段下方的填写提示，写清口径而不是写「请输入」"
        },
        "span": {
          "type": "number",
          "description": "占几列，默认 1；整行写 2"
        },
        "value": {
          "type": "string",
          "description": "原型预填值，用于展示典型填写状态"
        },
        "field": {
          "type": "string",
          "description": "引用的业务字段键（fieldCatalog[].key）；缺省时等于本字段 key。写错由 L2-96 报「不在 fieldCatalog」"
        },
        "rules": {
          "type": "object",
          "description": "本处的录入校验。同一字段两处录入，必填性可以不同，所以归渲染位不归主档",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 6,
              "description": "校验口径，写清口径而不是写「按需填写」"
            },
            "message": {
              "type": "string",
              "description": "校验失败提示，逐字可抄"
            }
          }
        }
      }
    },
    "stateMachine": {
      "type": "object",
      "required": [
        "id",
        "entity",
        "initial",
        "states",
        "transitions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sm-[A-Za-z0-9_-]+$"
        },
        "entity": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "initial": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "tone": {
                "type": "string",
                "enum": [
                  "default",
                  "processing",
                  "success",
                  "warning",
                  "error"
                ]
              },
              "terminal": {
                "type": "boolean",
                "description": "没有出口的状态必须显式标 true。不标就等于「忘了写出口」，用户会把单子卡在这里"
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "trigger"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "trigger": {
                "type": "string",
                "description": "cap-* 命令 id，或 system-* 自动流转"
              },
              "actor": {
                "type": "string"
              },
              "guard": {
                "type": "string"
              },
              "system": {
                "type": "boolean",
                "description": "定时任务 / 回调 / 超时关闭，标 true 可无命令入口"
              }
            }
          }
        }
      }
    },
    "dataModel": {
      "type": "object",
      "required": [
        "entities"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "fields"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "string",
                        "text",
                        "number",
                        "decimal",
                        "date",
                        "datetime",
                        "bool",
                        "enum",
                        "ref",
                        "file",
                        "json"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "pk": {
                      "type": "boolean"
                    },
                    "fk": {
                      "type": "string",
                      "description": "外键指向的实体 id"
                    },
                    "enum": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "constraint": {
                      "type": "string"
                    },
                    "unit": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "kind"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "1:1",
                  "1:N",
                  "N:1",
                  "N:M"
                ]
              },
              "on": {
                "type": "string"
              }
            }
          }
        },
        "derived": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "expr",
              "fallback"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "expr": {
                "type": "string"
              },
              "fallback": {
                "type": "string",
                "description": "无数据时的替代口径，必填，防止研发自行发明"
              }
            }
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "actor",
        "trigger",
        "rule",
        "stateMachine",
        "expectation",
        "acceptance",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[0-9]{3,}$"
        },
        "title": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "description": "EARS·角色：谁，用岗位而非人名"
        },
        "trigger": {
          "type": "string",
          "description": "EARS·触发：何时/何事触发"
        },
        "rule": {
          "type": "string",
          "description": "EARS·规则：约束与前置校验，无主观词"
        },
        "stateMachine": {
          "type": "string",
          "description": "EARS·状态机：关联状态机 id + 迁移条件"
        },
        "expectation": {
          "type": "string",
          "description": "EARS·预期：系统响应，单一响应"
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "given",
              "when",
              "then",
              "kind"
            ],
            "properties": {
              "given": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "then": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "happy",
                  "illegal"
                ]
              }
            }
          }
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pc",
              "pda"
            ]
          }
        },
        "pageIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "stated",
            "inferred"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "confirmed"
          ]
        }
      }
    },
    "navItem": {
      "type": "object",
      "description": "侧边导航的一节。功能少的项目只有一层；功能超过 12 个必须分组，超过 3 层说明信息架构没想清楚。",
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "同级内唯一，折叠状态按它记忆"
        },
        "label": {
          "type": "string"
        },
        "page": {
          "type": "string",
          "description": "点它跳到哪一页；不填表示本原型未建模，点了给原因"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "待办数角标"
        },
        "on": {
          "type": "boolean",
          "description": "没有 page 时用它手工标当前项"
        },
        "collapsed": {
          "type": "boolean",
          "description": "默认是否折叠子项。当前页在这个分支里时一律展开，不受它影响"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navItem"
          }
        }
      }
    },
    "navGroup": {
      "type": "object",
      "required": [
        "title",
        "items"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navItem"
          }
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": [
        "id",
        "pageId",
        "nodeId",
        "anchor",
        "body",
        "status",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^an-[A-Za-z0-9_-]+$"
        },
        "pageId": {
          "type": "string"
        },
        "nodeId": {
          "type": "string",
          "description": "锚定组件节点 id；重生成原型时不得变更"
        },
        "anchor": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "description": "相对锚定节点的归一化坐标，与缩放无关"
        },
        "body": {
          "type": "string",
          "minLength": 2
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocker",
            "major",
            "minor",
            "question"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "wontfix"
          ]
        },
        "author": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "componentTree",
              "interaction",
              "state",
              "requirement",
              "capability",
              "prd"
            ]
          }
        },
        "resolvedAt": {
          "type": "string",
          "description": "标记已解决的时间"
        },
        "resolution": {
          "type": "string",
          "minLength": 2,
          "description": "怎么改的。已解决（resolved/wontfix）必填——只写「改了」，下一轮没人知道当时改成了什么"
        },
        "target": {
          "type": "object",
          "description": "标注落点的快照。原型重新生成后 nodeId 可能不存在了，靠它把标注还原到「哪个页面的哪一块」，不让历史意见凭空消失",
          "required": [
            "pageTitle"
          ],
          "properties": {
            "pageTitle": {
              "type": "string"
            },
            "nodeLabel": {
              "type": "string",
              "description": "被标注元素的可读名，如「预防措施按钮」「当前状态列」"
            },
            "nodeText": {
              "type": "string",
              "description": "被标注元素当时的文本，用于人工辨认"
            },
            "carrier": {
              "type": "string",
              "enum": [
                "page",
                "dialog",
                "drawer"
              ],
              "description": "标注落在页面上还是在弹框/抽屉里。落在弹层里的，弹层要不要开决定 pin 画不画"
            },
            "capId": {
              "type": "string",
              "description": "carrier 为 dialog/drawer 时，是哪个命令的弹层"
            }
          }
        },
        "replies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "body",
              "at"
            ],
            "properties": {
              "body": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "by": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "componentDef": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "states"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "pc-shell",
            "pc-data",
            "pc-input",
            "pda",
            "common"
          ]
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "props": {
          "type": "object"
        },
        "usage": {
          "type": "string"
        }
      }
    },
    "pdaPolicy": {
      "type": "object",
      "description": "PDA 端专有约束。PDA 不是 PC 缩小版，必须逐页声明现场作业策略",
      "properties": {
        "onlineOnly": {
          "type": "boolean",
          "description": "必须显式声明；false 时需提供 offline"
        },
        "offline": {
          "type": "object",
          "properties": {
            "queue": {
              "type": "boolean"
            },
            "conflict": {
              "type": "string",
              "enum": [
                "last-write-wins",
                "server-wins",
                "manual"
              ]
            },
            "cacheTtlMinutes": {
              "type": "integer"
            }
          }
        },
        "scan": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "codeTypes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "qrcode",
                  "barcode",
                  "rfid",
                  "ocr"
                ]
              }
            }
          }
        },
        "primaryAction": {
          "type": "string",
          "description": "拇指热区主操作，一屏只能有一个"
        },
        "minTouchTarget": {
          "type": "integer",
          "default": 44
        }
      }
    },
    "openQuestion": {
      "type": "object",
      "required": [
        "id",
        "question",
        "priority",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q-[0-9]+$"
        },
        "question": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "assumed"
          ]
        },
        "answer": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "stage",
        "kind",
        "decision",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D-[0-9]{3}$"
        },
        "stage": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "scope",
            "model",
            "tradeoff",
            "no-decision"
          ]
        },
        "decision": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "active": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "guard": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^g-[0-9]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "block",
            "warn"
          ]
        },
        "statement": {
          "type": "string",
          "description": "源文档原句（含必须/不得/仅当/至少）"
        },
        "sourceRef": {
          "type": "string"
        },
        "capabilityId": {
          "type": "string"
        },
        "fallback": {
          "type": "string",
          "description": "不在界面体现时的理由"
        },
        "expr": {
          "type": "string",
          "description": "可判定形式（表达式/伪代码）。给人看的口径写 statement；这条是给机器与测试用的，可选"
        },
        "message": {
          "type": "string",
          "description": "不满足时给用户看的那句话，逐字可抄；挂了 capabilityId 的 guard 必填（L2-102）"
        }
      }
    },
    "fieldCatalogItem": {
      "type": "object",
      "description": "一个业务字段的一生：身份、从哪来（source）、到哪去（target）。位置信息不在这里——它归渲染位",
      "required": [
        "key",
        "label",
        "source"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]*$",
          "description": "业务键，小驼峰；与落库字段同名为佳。不是任何一处渲染位的 key"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "description": "业务全名。渲染位的界面文案（如列头「等级」）不要求与它相等——那是文案，不是身份"
        },
        "source": {
          "$ref": "#/$defs/dataSourceRef"
        },
        "target": {
          "type": "object",
          "description": "落库去向。只有会被录入的字段才必须有；纯计算、纯筛选字段没有",
          "required": [
            "entity",
            "field"
          ],
          "properties": {
            "entity": {
              "type": "string"
            },
            "field": {
              "type": "string"
            }
          }
        },
        "reqRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "需求出处：流程小节、决策 id。一条字段常同时来自多处"
        },
        "note": {
          "type": "string",
          "description": "口径例外、统计含义这类「不放会出错」的话"
        }
      }
    },
    "dataSource": {
      "type": "object",
      "description": "一个取数口。只到「哪个口、哪一格」，不下钻接口与库表字段",
      "required": [
        "id",
        "kind",
        "ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ds-[A-Za-z0-9_-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "entity",
            "dict",
            "calc",
            "api",
            "system"
          ],
          "description": "entity=本系统实体；dict=字典；calc=计算口径（必须是 dataModel.derived 里的 name）；api=外部接口；system=系统生成（单号/时间/当前人）"
        },
        "ref": {
          "type": "string",
          "description": "entity=实体 id；dict=实体.字段 或外部字典名；calc=dataModel.derived[].name；api=接口/对象名；system=生成物标识"
        },
        "note": {
          "type": "string",
          "description": "外部字典与 api 必须写：说明为什么机器核不了"
        }
      }
    },
    "dataSourceRef": {
      "type": "object",
      "description": "字段级取数引用：从哪个口的哪一格取、取不到怎么兜底",
      "required": [
        "ds"
      ],
      "properties": {
        "ds": {
          "type": "string"
        },
        "field": {
          "type": "string",
          "description": "取数口内的字段名；entity/dict/api 必填"
        },
        "rule": {
          "type": "string",
          "description": "calc/system 必填：算式口径或生成规则（单号格式、当前时间、当前人）"
        },
        "fallback": {
          "type": "string",
          "description": "取不到时的兜底口径"
        }
      }
    },
    "pageGroup": {
      "type": "object",
      "description": "页面目录里的一组页。功能一多，平铺目录就要靠记忆找；按功能聚合，组可以套组。分组本身不是目的地，叶子必须给 page。",
      "required": [
        "key",
        "title"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "同级内唯一，开合状态按它记"
        },
        "title": {
          "type": "string"
        },
        "page": {
          "type": "string",
          "description": "点它跳到哪一页；分组一般不带，带了表示这一组的主入口"
        },
        "collapsed": {
          "type": "boolean",
          "description": "默认是否收起。当前页在这个分支里时一律展开"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pageGroup"
          }
        }
      }
    }
  }
}
