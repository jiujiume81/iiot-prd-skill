{
 "schemaVersion": "1.0",
 "meta": {
  "product": "新锂想QMS · 来料检验",
  "version": "0.1.0",
  "domain": "qms",
  "targets": [
   "pc",
   "pda"
  ],
  "designWidth": {
   "pc": 1440,
   "pda": 390
  },
  "baseResolution": "1920x1080",
  "currentPageId": "pg-iqc-ledger",
  "skin": "industrial-petrol"
 },
 "modules": [
  {
   "id": "m-iqc",
   "code": "IQC",
   "name": "来料检验",
   "order": 1,
   "owner": "质量部",
   "icon": "inbox",
   "pages": [
    "pg-iqc-ledger",
    "pg-iqc-detail",
    "pg-iqc-sample"
   ]
  }
 ],
 "pages": [
  {
   "id": "pg-iqc-ledger",
   "moduleId": "m-iqc",
   "target": "pc",
   "route": "/iqc/ledger",
   "title": "来料检验台账",
   "entity": "inspection",
   "listRole": "primary",
   "contract": {
    "owns": [
     "cap-receive",
     "cap-make-checklist",
     "cap-judge-pass",
     "cap-judge-fail",
     "cap-concession",
     "cap-return",
     "cap-approve-urgent-release"
    ]
   }
  },
  {
   "id": "pg-iqc-detail",
   "moduleId": "m-iqc",
   "target": "pc",
   "route": "/iqc/ledger/:id",
   "title": "检验报告详情",
   "entity": "inspection",
   "layout": "detail",
   "contract": {
    "owns": []
   }
  },
  {
   "id": "pg-iqc-sample",
   "moduleId": "m-iqc",
   "target": "pda",
   "route": "/pda/sample/:id",
   "title": "取样任务",
   "entity": "inspection",
   "contract": {
    "owns": [
     "cap-submit-sample"
    ]
   }
  }
 ],
 "capabilities": [
  {
   "id": "cap-receive",
   "name": "收货建检验任务",
   "label": "收货建检验任务",
   "actor": [
    "u-keeper"
   ],
   "entity": "inspection",
   "from": [
    "received"
   ],
   "to": "pending",
   "policy": "disabled",
   "reason": "仅「已到货」可建检验任务",
   "stage": "submit"
  },
  {
   "id": "cap-make-checklist",
   "name": "生成必检清单",
   "label": "生成必检清单",
   "actor": [
    "u-inspector"
   ],
   "entity": "inspection",
   "from": [
    "pending"
   ],
   "to": "sampling",
   "policy": "disabled",
   "reason": "仅「待检」可生成必检清单",
   "stage": "submit"
  },
  {
   "id": "cap-submit-sample",
   "name": "提交取样记录",
   "label": "提交取样记录",
   "actor": [
    "u-sampler"
   ],
   "entity": "inspection",
   "from": [
    "sampling"
   ],
   "to": "judging",
   "policy": "disabled",
   "reason": "仅「待取样」可提交取样记录",
   "stage": "submit"
  },
  {
   "id": "cap-approve-urgent-release",
   "name": "批准紧急放行",
   "label": "批准紧急放行",
   "actor": [
    "u-qm"
   ],
   "entity": "inspection",
   "from": [
    "pending"
   ],
   "to": "frozen",
   "policy": "disabled",
   "reason": "仅「待检」且产线断料时可批准紧急放行",
   "stage": "verify"
  },
  {
   "id": "cap-judge-pass",
   "name": "判定合格",
   "label": "判定合格",
   "actor": [
    "u-qa"
   ],
   "entity": "inspection",
   "from": [
    "judging"
   ],
   "to": "released",
   "policy": "disabled",
   "reason": "仅「待判定」可判定，且判定人不得是取样人",
   "stage": "verify"
  },
  {
   "id": "cap-judge-fail",
   "name": "判定不合格",
   "label": "判定不合格",
   "actor": [
    "u-qa"
   ],
   "entity": "inspection",
   "from": [
    "judging"
   ],
   "to": "disposal",
   "policy": "disabled",
   "reason": "仅「待判定」可判定，且判定人不得是取样人",
   "stage": "verify"
  },
  {
   "id": "cap-concession",
   "name": "批准让步接收",
   "label": "批准让步接收",
   "actor": [
    "u-qm"
   ],
   "entity": "inspection",
   "from": [
    "disposal"
   ],
   "to": "released",
   "policy": "disabled",
   "reason": "仅「待处置」可批准让步接收，必须填有效期",
   "stage": "verify"
  },
  {
   "id": "cap-return",
   "name": "批准退货",
   "label": "批准退货",
   "actor": [
    "u-qm"
   ],
   "entity": "inspection",
   "from": [
    "disposal"
   ],
   "to": "voided",
   "policy": "disabled",
   "reason": "仅「待处置」可批准退货",
   "stage": "verify"
  }
 ],
 "stateMachines": [
  {
   "id": "sm-incoming",
   "entity": "inspection",
   "label": "来料检验单生命周期",
   "initial": "received",
   "states": [
    {
     "key": "received",
     "label": "已到货",
     "tone": "default"
    },
    {
     "key": "pending",
     "label": "待检",
     "tone": "processing"
    },
    {
     "key": "frozen",
     "label": "待检冻结",
     "tone": "warning"
    },
    {
     "key": "sampling",
     "label": "待取样",
     "tone": "processing"
    },
    {
     "key": "judging",
     "label": "待判定",
     "tone": "warning"
    },
    {
     "key": "disposal",
     "label": "待处置",
     "tone": "danger"
    },
    {
     "key": "released",
     "label": "已放行",
     "tone": "success"
    },
    {
     "key": "voided",
     "label": "已作废",
     "tone": "muted",
     "terminal": true
    },
    {
     "key": "archived",
     "label": "已归档",
     "tone": "success",
     "terminal": true
    }
   ],
   "transitions": [
    {
     "from": "received",
     "to": "pending",
     "trigger": "cap-receive",
     "actor": "u-keeper"
    },
    {
     "from": "pending",
     "to": "sampling",
     "trigger": "cap-make-checklist",
     "actor": "u-inspector"
    },
    {
     "from": "pending",
     "to": "frozen",
     "trigger": "cap-approve-urgent-release",
     "actor": "u-qm"
    },
    {
     "from": "sampling",
     "to": "judging",
     "trigger": "cap-submit-sample",
     "actor": "u-sampler"
    },
    {
     "from": "judging",
     "to": "released",
     "trigger": "cap-judge-pass",
     "actor": "u-qa"
    },
    {
     "from": "judging",
     "to": "disposal",
     "trigger": "cap-judge-fail",
     "actor": "u-qa"
    },
    {
     "from": "disposal",
     "to": "released",
     "trigger": "cap-concession",
     "actor": "u-qm"
    },
    {
     "from": "disposal",
     "to": "voided",
     "trigger": "cap-return",
     "actor": "u-qm"
    },
    {
     "from": "frozen",
     "to": "released",
     "trigger": "system-unfreeze",
     "system": true
    },
    {
     "from": "frozen",
     "to": "voided",
     "trigger": "system-seize",
     "system": true
    },
    {
     "from": "released",
     "to": "archived",
     "trigger": "system-archive",
     "system": true
    }
   ]
  }
 ],
 "dataModel": {
  "entities": [
   {
    "id": "inspection",
    "name": "Inspection",
    "label": "检验任务",
    "fields": [
     {
      "name": "batchNo",
      "label": "到货单号",
      "type": "string",
      "pk": true,
      "required": true
     },
     {
      "name": "taskNo",
      "label": "任务单号",
      "type": "string",
      "required": true
     },
     {
      "name": "material",
      "label": "物资名称",
      "type": "string",
      "required": true
     },
     {
      "name": "qty",
      "label": "到货数量",
      "type": "number",
      "required": true,
      "unit": "件"
     },
     {
      "name": "sampleQty",
      "label": "取样数量",
      "type": "number",
      "constraint": "1 <= sampleQty <= qty"
     },
     {
      "name": "supplier",
      "label": "供应商名称",
      "type": "string"
     },
     {
      "name": "stdTemplateId",
      "label": "质检标准模板",
      "type": "ref",
      "fk": "stdTemplate"
     },
     {
      "name": "status",
      "label": "状态",
      "type": "enum",
      "enum": [
       "created",
       "sampled",
       "reported",
       "approved"
      ],
      "required": true
     },
     {
      "name": "spec",
      "label": "规格型号",
      "type": "string"
     },
     {
      "name": "supplierBatch",
      "label": "供应商批次号",
      "type": "string"
     },
     {
      "name": "reviewOpinion",
      "label": "审核意见",
      "type": "string"
     }
    ]
   },
   {
    "id": "stdTemplate",
    "name": "StdTemplate",
    "label": "质检标准模板",
    "fields": [
     {
      "name": "id",
      "type": "string",
      "pk": true
     },
     {
      "name": "name",
      "label": "模板名称",
      "type": "string",
      "required": true
     },
     {
      "name": "version",
      "label": "版本",
      "type": "string",
      "required": true
     }
    ]
   }
  ],
  "relations": [
   {
    "from": "inspection",
    "to": "stdTemplate",
    "kind": "N:1",
    "on": "stdTemplateId"
   }
  ],
  "derived": [
   {
    "name": "取样完成率",
    "expr": "sampledCount / totalCount",
    "fallback": "无任务时显示「—」而非 0%"
   },
   {
    "name": "来料合格率",
    "expr": "passBatch / inspectedBatch",
    "fallback": "检验批次为 0 时显示「—」，不显示 0%（0% 会被误读为全不合格）"
   },
   {
    "name": "报告及时率",
    "expr": "reportWithin24h / reportedTotal",
    "fallback": "报告尚未生成的单据不计入分母；迁移数据（migrated）不参与计算"
   }
  ]
 },
 "requirements": [
  {
   "id": "REQ-001",
   "title": "收货后建检验任务",
   "actor": "仓库保管员",
   "trigger": "货卸到待检区且采购单存在时",
   "rule": "采购单存在且到货量未超收 5%；物料已登记检验标准；同一到货单不许重复建任务",
   "stateMachine": "sm-incoming：received → pending（cap-receive）",
   "expectation": "生成待检任务并分配内部批号",
   "acceptance": [
    {
     "given": "采购单存在、到货量在允许范围内",
     "when": "保管员提交收货",
     "then": "生成待检任务并显示内部批号",
     "kind": "happy"
    },
    {
     "given": "该到货单已建过任务",
     "when": "再次提交",
     "then": "拒绝并提示「该到货单已有检验任务」",
     "kind": "illegal"
    },
    {
     "given": "到货量超过采购量 5%",
     "when": "提交",
     "then": "就地标红并拒绝提交",
     "kind": "illegal"
    }
   ],
   "priority": "P0",
   "targets": [
    "pc"
   ],
   "pageIds": [
    "pg-iqc-ledger"
   ],
   "source": "stated",
   "status": "confirmed"
  },
  {
   "id": "REQ-002",
   "title": "现场取样并提交",
   "actor": "取样员",
   "trigger": "任务处于待取样且取样员在货场扫描桶身码时",
   "rule": "取样量在 AQL 上下限内；扫码失败可手输后 6 位；无网络时先存本机，恢复后自动补传",
   "stateMachine": "sm-incoming：sampling → judging（cap-submit-sample）",
   "expectation": "保存取样记录并把任务置为待判定",
   "acceptance": [
    {
     "given": "任务为待取样且网络正常",
     "when": "录入取样量并提交",
     "then": "记录保存，状态变为待判定",
     "kind": "happy"
    },
    {
     "given": "任务不是待取样",
     "when": "提交",
     "then": "按钮置灰并提示「仅待取样可提交」",
     "kind": "illegal"
    },
    {
     "given": "取样量为 0 或超过到货量",
     "when": "提交",
     "then": "拒绝并标红，提示允许范围",
     "kind": "illegal"
    },
    {
     "given": "货场无信号",
     "when": "提交",
     "then": "存本机并显示待上传角标，恢复后自动上传",
     "kind": "illegal"
    }
   ],
   "priority": "P0",
   "targets": [
    "pda"
   ],
   "pageIds": [
    "pg-iqc-sample"
   ],
   "source": "stated",
   "status": "confirmed"
  },
  {
   "id": "REQ-003",
   "title": "判定合格并放行",
   "actor": "质量工程师",
   "trigger": "取样记录齐全、任务处于待判定时",
   "rule": "所用标准在有效期内且限值快照可读；判定人不得是取样人；判定不可撤销，误判只能作废重开",
   "stateMachine": "sm-incoming：judging → released（cap-judge-pass）",
   "expectation": "出判定结论与报告，状态置为已放行",
   "acceptance": [
    {
     "given": "标准有效、限值在范围内",
     "when": "判定合格",
     "then": "生成报告并放行",
     "kind": "happy"
    },
    {
     "given": "判定人与取样人相同",
     "when": "判定合格",
     "then": "拒绝并提示走质量负责人授权码",
     "kind": "illegal"
    },
    {
     "given": "所用标准已过期",
     "when": "判定合格",
     "then": "拒绝并提示联系技术部",
     "kind": "illegal"
    }
   ],
   "priority": "P0",
   "targets": [
    "pc"
   ],
   "pageIds": [
    "pg-iqc-ledger",
    "pg-iqc-detail"
   ],
   "source": "stated",
   "status": "confirmed"
  },
  {
   "id": "REQ-004",
   "title": "判定不合格并转处置",
   "actor": "质量工程师",
   "trigger": "存在超限项且任务处于待判定时",
   "rule": "超限项必须逐项记录；判不合格即冻结该批库存；处置单与不合格通知同时生成",
   "stateMachine": "sm-incoming：judging → disposal（cap-judge-fail）",
   "expectation": "生成处置单，状态置为待处置，库存冻结",
   "acceptance": [
    {
     "given": "超限项已逐项记录",
     "when": "判定不合格",
     "then": "生成处置单并冻结库存",
     "kind": "happy"
    },
    {
     "given": "超限项未填",
     "when": "判定不合格",
     "then": "拒绝并定位到未填项",
     "kind": "illegal"
    },
    {
     "given": "任务不是待判定",
     "when": "判定不合格",
     "then": "按钮置灰并提示当前状态",
     "kind": "illegal"
    }
   ],
   "priority": "P0",
   "targets": [
    "pc"
   ],
   "pageIds": [
    "pg-iqc-ledger"
   ],
   "source": "stated",
   "status": "confirmed"
  },
  {
   "id": "REQ-005",
   "title": "让步接收需客户知情",
   "actor": "质量负责人",
   "trigger": "处置单待批且客户已回复是否知情时",
   "rule": "审批人不得是取样人；必须填有效期与客户是否知情；让步批在台账上有「让步」标识",
   "stateMachine": "sm-incoming：disposal → released（cap-concession）",
   "expectation": "生成让步单，状态置为已放行并打标识",
   "acceptance": [
    {
     "given": "客户知情且已填有效期",
     "when": "批准让步接收",
     "then": "生成让步单并打「让步」标识",
     "kind": "happy"
    },
    {
     "given": "有效期为空",
     "when": "批准让步接收",
     "then": "拒绝并提示必填",
     "kind": "illegal"
    },
    {
     "given": "审批人是本批取样人",
     "when": "批准让步接收",
     "then": "拒绝并提示四眼原则",
     "kind": "illegal"
    }
   ],
   "priority": "P0",
   "targets": [
    "pc"
   ],
   "pageIds": [
    "pg-iqc-ledger"
   ],
   "source": "stated",
   "status": "confirmed"
  }
 ],
 "components": [],
 "annotations": [],
 "openQuestions": [
  {
   "id": "Q-01",
   "question": "待检超期后库位占用费由谁承担，是否需要进系统计算",
   "status": "assumed",
   "decision": "先只做超期红条提示，不做费用计算"
  }
 ],
 "decisions": [
  {
   "id": "D-001",
   "stage": "model",
   "kind": "tradeoff",
   "decision": "抽检基准按内部收货流水号，不按供应商批号",
   "rationale": "供应商批号会断号、会换规则；按批号计数会让该检的漏检、免检的重复检",
   "active": true
  },
  {
   "id": "D-002",
   "stage": "model",
   "kind": "scope",
   "decision": "判定不可撤销，误判只能作废重开并留痕",
   "rationale": "判定会触发库存冻结与放行，可撤销就等于允许改结论；作废重开留下完整轨迹",
   "active": true
  },
  {
   "id": "D-003",
   "stage": "model",
   "kind": "tradeoff",
   "decision": "让步接收必须由质量负责人批，且必须记录客户是否知情",
   "rationale": "让步批流入产线的风险由客户承担，不记录知情就是单方面放行",
   "active": true
  }
 ],
 "guards": [
  {
   "id": "g-std-expired",
   "kind": "block",
   "statement": "所用检验标准必须在有效期内且限值快照可读，否则不许判定",
   "capabilityId": "cap-judge-pass",
   "sourceRef": "M5 系统状态类",
   "message": "该物料的标准已过期，请先联系技术部发布新版本，再判定。"
  },
  {
   "id": "g-recipe-version",
   "kind": "block",
   "statement": "标准导入必须绑定配方版本与生效日；与历史值差 10 倍即拦截",
   "capabilityId": "cap-judge-pass",
   "sourceRef": "M5 工艺与配方类",
   "message": "本标准挂的配方版本与当前物料不一致，判定会算错限值，请先核对版本。"
  },
  {
   "id": "g-four-eyes",
   "kind": "block",
   "statement": "判定人不得是本批取样人；紧急情况用质量负责人授权码代过并留痕",
   "capabilityId": "cap-judge-pass",
   "sourceRef": "M5 权限类",
   "message": "取样人和判定人是同一人，违反四眼原则；请换人或用质量负责人授权码。"
  },
  {
   "id": "g-batch-break",
   "kind": "warn",
   "statement": "供应商批号断号时抽检基准改按内部收货流水号，断号位置在清单上标出",
   "capabilityId": "cap-make-checklist",
   "sourceRef": "M5 追溯断链类",
   "message": "该供应商批号有断号，已按内部流水号重算抽检频次，请在清单上核对断号段。"
  }
 ],
 "fieldCatalog": [
  {
   "key": "batchNo",
   "label": "到货单号",
   "source": {
    "ds": "ds-wms",
    "field": "arrivalNo",
    "fallback": "WMS 取不到时按扫描枪录入的单号落库"
   },
   "note": "WMS 到货单主键，本系统只读"
  },
  {
   "key": "taskNo",
   "label": "任务单号",
